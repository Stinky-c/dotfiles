{
    "layer": "bottom",
    "position": "bottom",
    "mod": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "margin-bottom": -1,
    "passthrough": false,
    "height": 41,
    "modules-left": [
        "custom/os_button",
        "cffi/niri-taskbar"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "network",
        "clock"
    ],
    "custom/os_button": {
        "format": "X",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "cffi/niri-taskbar": {
        "module_path": "/usr/lib/waybar/libniri_taskbar.so",
        "icon-size": 28,
        "spacing": 3,
        "all-outputs": true,
        "on-click": "activate",
        "on-click-middle": "close",
        "tooltip-format": "{title}",
        // "notifications": true,
        "ignore-list": []
    },
    "tray": {
        "icon-size": 18,
        "spacing": 3
    },
    "clock": {
        "format": " {:%OI:%M %p\n %F}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "network": {
        "on-click-right": "nm-connection-editor",
        "format-wifi": " {icon}",
        "format-ethernet": "  ",
        "format-disconnected": "󰌙",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "format-icons": [
            "󰤯 ",
            "󰤟 ",
            "󰤢 ",
            "󰤢 ",
            "󰤨 "
        ]
    },
    "pulseaudio": {
        "max-volume": 150,
        "scroll-step": 5,
        "format": "{icon}",
        "tooltip-format": "{volume}%",
        "format-muted": " ",
        "format-icons": {
            "default": [
                " ",
                " ",
                " "
            ]
        },
        "on-click-right": "pavucontrol"
    },
    "mpris": {
        "interval": 1,
        "format": "{title} - {artist} <small>[{position}/{length}]</small> {status_icon}",
        "tooltip-format": "{title} - {artist} <small>[{position}/{length}]</small> {status_icon}",
        "status-icons": {
            "paused": "",
            "playing": "",
            "stopped": ""
        },
        "dynamic-len": 50,
        "ignored-players": []
    },
}